import numpy as np
import matplotlib.pyplot as plt
from scipy.signal import find_peaks

np.random.seed(42)
t = np.linspace(0, 100, 2000)

# scenario a: stable
data_a = np.sin(2 * np.pi * 0.5 * t) + 0.03 * np.random.randn(len(t))

# scenario b: chaotic/fatigue
data_b = (np.sin(2 * np.pi * 0.5 * t) * (1 + 0.5 * np.sin(2 * np.pi * 0.08 * t)) 
          + 0.3 * np.sin(2 * np.pi * 1.3 * t) 
          + 0.1 * np.random.randn(len(t)))

def plot_ps(ax, d, tau, title, col):
    x1 = d[:-tau]
    x2 = d[tau:]
    ax.plot(x1, x2, color=col, lw=0.8, alpha=0.7)
    ax.set_title(title, fontsize=12, fontweight='bold')
    ax.set_xlabel('Kinematic State x(t)')
    ax.set_ylabel('Delayed State x(t+tau)')
    ax.grid(True, ls='--', alpha=0.5)

def plot_cobweb(ax, d, title, col):
    pks, _ = find_peaks(d, distance=20)
    xn = d[pks[:-1]]
    xn1 = d[pks[1:]]
    
    m_min, m_max = min(xn), max(xn)
    pad = (m_max - m_min) * 0.1
    
    ax.plot([m_min - pad, m_max + pad], [m_min - pad, m_max + pad], 'r--', label='y=x')
    ax.plot(xn, xn1, 'o', color=col, ms=4, label='peaks')
    
    # cobweb lines
    for i in range(len(xn) - 1):
        ax.plot([xn[i], xn[i]], [xn[i], xn1[i]], 'k-', alpha=0.3, lw=0.8)
        ax.plot([xn[i], xn1[i]], [xn1[i], xn1[i]], 'k-', alpha=0.3, lw=0.8)
    
    ax.set_title(title, fontsize=12, fontweight='bold')
    ax.set_xlabel('Poincare Map: Peak n')
    ax.set_ylabel('Peak n+1')
    ax.legend()
    ax.grid(True, ls='--', alpha=0.5)

f, ax = plt.subplots(2, 2, figsize=(12, 10))
tau = 15 

plot_ps(ax[0, 0], data_a, tau, '(a) Phase Space: Syntropy (IRBI >= 0.70)', '#1f77b4')
plot_cobweb(ax[0, 1], data_a, '(a) Cobweb Plot: Stable Attractor', '#1f77b4')

plot_ps(ax[1, 0], data_b, tau, '(b) Phase Space: Fatigue / Chaos (IRBI < 0.70)', '#d62728')
plot_cobweb(ax[1, 1], data_b, '(b) Cobweb Plot: Erratic Orbit', '#d62728')

plt.tight_layout(pad=3.0)
plt.show()
