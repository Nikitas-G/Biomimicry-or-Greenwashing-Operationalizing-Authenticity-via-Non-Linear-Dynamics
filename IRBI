    # Monte Carlo Uncertainty Propagation (N=10,000)
    print(f"\nRunning Monte Carlo Uncertainty Propagation (N={N_MONTE_CARLO} draws)...")
    for i in range(N_MONTE_CARLO):
        w_draw = rng.dirichlet(30.0 * w_base)
