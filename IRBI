            ax.set_xlim(-2.2, 2.2)
            ax.set_ylim(-2.2, 2.2)

        plt.tight_layout()
        plt.savefig('Figure_5_Final.png', dpi=300)
        plt.close()
        print("Exported: 'Figure_5_Final.png' (300 DPI)")

    return df_kin

