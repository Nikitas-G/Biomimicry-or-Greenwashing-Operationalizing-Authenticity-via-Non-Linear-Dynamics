# COMPONENT 1: GUM CLAIM LEDGER & EXPECTED SHORTFALL (Eq. 1)

def expected_shortfall(c, mu, u):
    """
    Computes expected claim shortfall d_k = E[ clip((c - M)/c, 0, 1) ]
    where M ~ N(mu, u^2). Compliant with JCGM 100:2008 (GUM).
    """
    if pd.isna(mu) or pd.isna(c) or c <= 0:
        return 1.0  # Maximal failure (unsubstantiated / unquantified)
    if pd.isna(u) or u <= 1e-12:
        return float(np.clip((c - mu) / c, 0.0, 1.0))

    z0 = (0.0 - mu) / u
    zc = (c - mu) / u
    mid = ((c - mu) * (norm.cdf(zc) - norm.cdf(z0)) + u * (norm.pdf(zc) - norm.pdf(z0))) / c
    return float(np.clip(mid + norm.cdf(z0), 0.0, 1.0))


def evaluate_claim_status(c, mu, u, k_cover=2.0):
    """Assigns GUM compliance status using standard coverage factor K=2 (95% CI)."""
    if pd.isna(c):
        return "unfalsifiable"
    if pd.isna(mu):
        return "unsubstantiated"
    unc = 0.0 if pd.isna(u) else u
    if mu - k_cover * unc >= c:
        return "supported"
    if mu + k_cover * unc < c:
        return "refuted"
    return "inconclusive"

# COMPONENT2: AHP MATRIX & WEIGHT RENORMALIZATION

def compute_ahp_weights(M):
    """Computes principal eigenvector weights, lambda_max, and Consistency Ratio (CR)."""
    vals, vecs = np.linalg.eig(M)
    idx = np.argmax(vals.real)
    w = np.abs(vecs[:, idx].real)
    w /= np.sum(w)
    lam = vals[idx].real
    n = len(M)
    CI = (lam - n) / (n - 1)
    RI = 1.12  # Random Index for n=5
    CR = CI / RI
    return w, lam, CR


# Base 5x5 Pairwise Comparison Matrix (IBIEF dimensions c1..c5)
M_AHP_DEFAULT = np.array([
