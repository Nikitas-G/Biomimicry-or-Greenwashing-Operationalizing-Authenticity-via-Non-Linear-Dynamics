    [0.5, 1.0, 1.0, 1.0, 2.0],
    [0.5, 1.0, 1.0, 1.0, 2.0],
    [0.5, 0.5, 0.5, 0.5, 1.0]
])


# COMPOENT 3: IRBI NON-COMPENSATORY SYNTHESIS & HEAVISIDE VETO (Eq. 5 & 6)

def compute_ibief_geo(scores, w_base, dynamic_active, eps=FLOOR_EPS):
    """
    Computes dimensional geometric mean with dynamic mask renormalization.
    scores: 5-element array in [0, 1] (or rubric/4)
    """
    mask = np.ones(5, dtype=bool)
    if not dynamic_active:
        mask[1] = False  # c2: Engineering Integrity n/a
        mask[2] = False  # c3: Adaptive Capacity n/a

    c_sub = scores[mask]
    w_sub = w_base[mask] / np.sum(w_base[mask])
    return float(np.prod(np.maximum(c_sub, eps) ** w_sub))


def compute_irbi(iif_norm, ibief_geo, has_refuted_core=False, tau=TAU_DEFAULT,
                 alpha=ALPHA, beta=BETA):
    """
    Computes composite IRBI with Heaviside Veto gatekeeper:
      IRBI = G * (1 - IIF_norm)^alpha * (IBIEF_geo)^beta
      G = I(no refuted core) * H(tau - IIF_norm)
    """
    if has_refuted_core or (iif_norm >= tau):
        return 0.0
    return float(((1.0 - iif_norm) ** alpha) * (ibief_geo ** beta))


