                mc_draws[name][i] = compute_irbi(iif_draw, ib_draw, False, tau_draw)
            elif name == "Sharkskin":
                iif_draw = np.clip(p["iif_norm"] + rng.normal(0, 0.05), 0.0, 1.0)
                c_draw = p["c_scores"].copy()
                valid = ~np.isnan(c_draw)
                c_draw[valid] = np.clip(c_draw[valid] + rng.choice([-0.25, 0.0, 0.25], int(valid.sum()), p=[0.2, 0.6, 0.2]), 0.05, 1.0)
